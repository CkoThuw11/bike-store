# Defaults below are also hardcoded into the docs' copy-paste commands
# (e.g. the seed_dev_data.sql psql command). Change values freely for your
# own machine, but update those commands too if you do.
DATABASE_HOST=db
DATABASE_NAME=bike_store
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

AUTH_SECRET_KEY=change-this-to-a-random-secret-key
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_DEBUG=true

LOG_LEVEL=INFO
LOG_FORMAT=text